<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity projesindeki kurallar katmanını (Assets/_Project/Scripts/Core) Unity olmadan derler.
    Hedef ve dil sürümü Unity 6 ile aynıdır: .NET Standard 2.1, C# 9.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>PixTrain.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/PixTrain/Assets/_Project/Scripts/Core/**/*.cs" />
  </ItemGroup>

</Project>
